# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/smartDB"

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET="medismart-jwt-secret-key-2024"
JWT_REFRESH_SECRET="medismart-refresh-secret-key-2024"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"

# ── Email (optional — app works without this) ─────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="noreply@medismart.com"

# ── AI (optional — enhances symptom analysis) ─────────────
GEMINI_API_KEY=""
